# ZETAPHY mainnet zetaphy_3659-1: the genesis config, as used by make-genesis.sh for genesis sha256
# ca0efb15f6ca80f57e157b32837e012a15f3dc3597531b18747629c8f0a94667. KEY=VALUE lines, parsed (never sourced).
# Final values, confirmed by the owner on 2026-11-13. Changing any value changes the genesis: do not edit.
#
# Public addresses and public keys only: nothing here is secret.

# ---- chain ----
CHAIN_ID=zetaphy_3659-1
EVM_CHAIN_ID=3659
# UTC; all validators start their node before this time.
GENESIS_TIME=2026-11-13T14:00:00Z

# ---- coin ----
DENOM=azetaphy
DENOM_ALIAS=attozetaphy
DISPLAY_DENOM=ztphy
SYMBOL=ZTPHY
COIN_NAME=ZETAPHY
DECIMALS=18
DENOM_DESCRIPTION=ZETAPHY Chain native coin
# 1,000,000,000 ZTPHY, fixed (no inflation; the constitution keeps it so)
TOTAL_SUPPLY=1000000000
# atto per gas; 1000000000 = 1 gwei, as on the testnet (transfer ~0.000021 ZTPHY)
MIN_GAS_PRICE=1000000000

# ---- allocations: ALLOC_<NAME>=<address> <whole ZTPHY> [vesting <start> <end>] ----
# Must add up to TOTAL_SUPPLY exactly. Pools: a multisig address is recommended (keys on hardware wallets held
# by different people, never on a node). Start/end: YYYY-MM-DDTHH:MM:SSZ or genesis+<days>d.
# rewards 50%
ALLOC_REWARDS=0x3B87f248a644aA66Bf35a33c26AbefF3326b3dD7 500000000
# SWD holders airdrop 20%
ALLOC_SWD_AIRDROP=0xaE842c15Ad4A6D6027597C3c3d44A4ada8FB0318 200000000
# community 15%
ALLOC_COMMUNITY=0x53E762B680b28a378cE33eafc6b6384D9DF4B989 150000000
# liquidity & partners 10% = 100,000,000, paid as: this pool + the validator's account + the circuit authority's
ALLOC_LIQUIDITY=0x859872fBaB7ad2C0663DC0253E61Cea628cA15d1 98999000
# the single validator's operator account (its key: made on the validator machine, file keyring); self-bond + fees
ALLOC_VALIDATOR=0xF9526e78d3f107c4147f83325Bc2bb42c3328B32 1000000
# the circuit-breaker multisig (same address as CIRCUIT_AUTHORITY), for its fees
ALLOC_CIRCUIT=0x8D0496dcD685ffc5a5e8Ed86f4648206783E8713 1000
# team 5%: locked 1 year, then linear to year 4
ALLOC_TEAM=0x58B726B2A5404b0374842fE15149294D139D62A8 50000000 vesting genesis+365d genesis+1460d

# ---- the validator(s) at genesis ----
# Owner decision: 1 validator at launch (docs/ZETAPHY-MAINNET-RUNBOOK.md, gate 2); more join later.
VALIDATORS=1
# whole ZTPHY the validator bonds in its gentx (below ALLOC_VALIDATOR)
SELF_BOND=500000

# ---- circuit-breaker authority: a multisig, at least 2 of at least 2 distinct keys ----
# Its address, and its public key as printed by `zetaphyd keys show <multisig> -p` (a file next to this one).
CIRCUIT_AUTHORITY=0x8D0496dcD685ffc5a5e8Ed86f4648206783E8713
CIRCUIT_AUTHORITY_PUBKEY_FILE=circuit-authority.pubkey.json

# ---- governance. The constitution freezes these as floors from block 1: choose them once. ----
GOV_VOTING_PERIOD=1d
GOV_EXPEDITED_VOTING_PERIOD=12h
GOV_MAX_DEPOSIT_PERIOD=14d
GOV_MIN_DEPOSIT=10000
GOV_EXPEDITED_MIN_DEPOSIT=50000
GOV_MIN_INITIAL_DEPOSIT_RATIO=0.25
GOV_QUORUM=0.334
GOV_THRESHOLD=0.5
GOV_VETO_THRESHOLD=0.334
GOV_EXPEDITED_THRESHOLD=0.667

# ---- staking and slashing ----
STAKING_UNBONDING_TIME=21d
STAKING_MAX_VALIDATORS=100
STAKING_MIN_COMMISSION_RATE=0.05
SLASHING_SIGNED_BLOCKS_WINDOW=10000
SLASHING_MIN_SIGNED_PER_WINDOW=0.05
SLASHING_DOWNTIME_JAIL_DURATION=10m
SLASHING_FRACTION_DOUBLE_SIGN=0.05
SLASHING_FRACTION_DOWNTIME=0.0001
DISTRIBUTION_COMMUNITY_TAX=0.02

# ---- chain guard ----
# Voting-power cap (bps of the active set; applies once there are 4 or more validators)
POWER_CAP_BPS=3333
# Q-day (ECDSA-only txs refused from this height): off unless set
QDAY_HEIGHT=
QDAY_REVEAL_DELAY=720
BLOCK_MAX_GAS=30000000
